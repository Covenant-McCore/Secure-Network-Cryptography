# ============================================================
# CRYPTO-NET — Environment Variable Template
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to git.
# ============================================================

# ---------- Flask ----------
FLASK_ENV=development
FLASK_SECRET_KEY=change-me-to-a-long-random-string
SESSION_COOKIE_SECURE=false

# ---------- Firebase Admin SDK ----------
# These come from the service account JSON you download from Firebase.
# On Railway, paste each value into the Railway Variables tab.
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_CERT_URL=
FIREBASE_UNIVERSE_DOMAIN=googleapis.com

# ---------- Cryptographic configuration ----------
# Master key used to derive policy-seed material for PolicyBasedAccessControl.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
PBAC_MASTER_SECRET=

# ---------- External security intelligence APIs ----------
# All optional. If unset, the corresponding module degrades gracefully.
ABUSEIPDB_API_KEY=
IPINFO_TOKEN=

# ---------- Application ----------
RATE_LIMIT_LOGIN=10 per minute
RATE_LIMIT_DEFAULT=200 per day
MAX_CONTENT_LENGTH_BYTES=5242880

